{
  "name": "aura-code",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.3",
  "publisher": "IChepe",
  "author": {
    "name": "IChepe",
    "email": "jdastorgamo1782@gmail.com",
    "url": "https://github.com/IChepe"
  },
  "license": "MIT",
  "homepage": "https://github.com/IChepe/aura-code#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/IChepe/aura-code.git"
  },
  "bugs": {
    "url": "https://github.com/IChepe/aura-code/issues",
    "email": "jdastorgamo1782@gmail.com"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#120f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "background",
    "transparent",
    "glass",
    "acrylic",
    "music",
    "fondo",
    "transparencia",
    "musica",
    "theme",
    "wallpaper engine",
    "visualizer",
    "fonts",
    "minecraft"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "auraMusic",
          "title": "%view.music.title%",
          "icon": "media/music.svg"
        }
      ]
    },
    "views": {
      "auraMusic": [
        {
          "type": "webview",
          "id": "aura.musicView",
          "name": "%view.music.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "aura.showMusic",
        "title": "%command.aura.showMusic%",
        "category": "Aura",
        "icon": "$(play-circle)"
      },
      {
        "command": "aura.openCatalog",
        "title": "%command.aura.openCatalog%",
        "category": "Aura",
        "icon": "$(sparkle)"
      },
      {
        "command": "aura.enable",
        "title": "%command.aura.enable%",
        "category": "Aura"
      },
      {
        "command": "aura.disable",
        "title": "%command.aura.disable%",
        "category": "Aura"
      },
      {
        "command": "aura.pickBackground",
        "title": "%command.aura.pickBackground%",
        "category": "Aura"
      },
      {
        "command": "aura.pickFont",
        "title": "%command.aura.pickFont%",
        "category": "Aura"
      },
      {
        "command": "aura.pickImage",
        "title": "%command.aura.pickImage%",
        "category": "Aura"
      },
      {
        "command": "aura.toggleMusic",
        "title": "%command.aura.toggleMusic%",
        "category": "Aura"
      },
      {
        "command": "aura.pickInstalledFont",
        "title": "%command.aura.pickInstalledFont%",
        "category": "Aura"
      },
      {
        "command": "aura.installFontFile",
        "title": "%command.aura.installFontFile%",
        "category": "Aura"
      },
      {
        "command": "aura.resetUiFont",
        "title": "%command.aura.resetUiFont%",
        "category": "Aura"
      },
      {
        "command": "aura.setVisibility",
        "title": "%command.aura.setVisibility%",
        "category": "Aura"
      },
      {
        "command": "aura.moreVisible",
        "title": "%command.aura.moreVisible%",
        "category": "Aura"
      },
      {
        "command": "aura.lessVisible",
        "title": "%command.aura.lessVisible%",
        "category": "Aura"
      },
      {
        "command": "aura.checkForUpdates",
        "title": "%command.aura.checkForUpdates%",
        "category": "Aura"
      },
      {
        "command": "aura.copyDiagnostics",
        "title": "%command.aura.copyDiagnostics%",
        "category": "Aura"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "aura.background": {
          "type": "string",
          "default": "aurora",
          "markdownDescription": "%config.aura.background.markdownDescription%"
        },
        "aura.customImage": {
          "type": "string",
          "default": "",
          "description": "%config.aura.customImage.description%"
        },
        "aura.glassOpacity": {
          "type": "number",
          "default": 0.78,
          "minimum": 0.1,
          "maximum": 1,
          "description": "%config.aura.glassOpacity.description%"
        },
        "aura.backgroundBlur": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 80,
          "description": "%config.aura.backgroundBlur.description%"
        },
        "aura.backgroundDim": {
          "type": "number",
          "default": 0.35,
          "minimum": 0,
          "maximum": 0.95,
          "description": "%config.aura.backgroundDim.description%"
        },
        "aura.music.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.aura.music.enabled.description%"
        },
        "aura.music.reactivity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.aura.music.reactivity.description%"
        },
        "aura.transparency": {
          "type": "string",
          "enum": [
            "off",
            "acrylic",
            "mica"
          ],
          "enumDescriptions": [
            "%config.aura.transparency.enumDescriptions.0%",
            "%config.aura.transparency.enumDescriptions.1%",
            "%config.aura.transparency.enumDescriptions.2%"
          ],
          "default": "off",
          "description": "%config.aura.transparency.description%"
        },
        "aura.windowOpacity": {
          "type": "number",
          "default": 0.92,
          "minimum": 0.3,
          "maximum": 1,
          "description": "%config.aura.windowOpacity.description%"
        },
        "aura.uiFont": {
          "type": "string",
          "default": "",
          "description": "%config.aura.uiFont.description%"
        },
        "aura.fontApplyToTerminal": {
          "type": "boolean",
          "default": true,
          "description": "%config.aura.fontApplyToTerminal.description%"
        },
        "aura.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.aura.debug.description%"
        },
        "aura.port": {
          "type": "number",
          "default": 47823,
          "description": "%config.aura.port.description%"
        },
        "aura.language": {
          "type": "string",
          "enum": [
            "auto",
            "es",
            "en"
          ],
          "enumDescriptions": [
            "%config.aura.language.enumDescriptions.0%",
            "%config.aura.language.enumDescriptions.1%",
            "%config.aura.language.enumDescriptions.2%"
          ],
          "default": "auto",
          "description": "%config.aura.language.description%"
        },
        "aura.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.aura.checkForUpdates.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "vscode:uninstall": "node ./out/uninstall.js",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
